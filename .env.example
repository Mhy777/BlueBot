# Copie para .env e preencha com seus próprios dados.
# Não coloque credenciais reais neste arquivo nem publique o arquivo .env.
API_ID=123456
API_HASH=COLOQUE_SEU_API_HASH
SOURCE_USERNAME=@grupo_origem
DESTINATION_USERNAME=@grupo_destino

# Filtros opcionais separados por | (barra vertical)
MESSAGE_FILTERS=texto indesejado|outra palavra
POLL_SECONDS=5

# O servidor WhatsApp local do projeto
WHATSAPP_SEND_URL=http://127.0.0.1:4000/send

# APIs oficiais de afiliados (se você usar esses módulos)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
